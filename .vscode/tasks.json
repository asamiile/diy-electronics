{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Compile (Wio Terminal)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "seeeduino:samd:seeed_wio_terminal",
        "${fileDirname}"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Arduino: Compile (Arduino Nano ESP32)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "arduino:esp32:nano_nora",
        "${fileDirname}"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Arduino: List Connected Boards",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "board",
        "list"
      ],
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload (Wio Terminal)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "upload",
        "-p",
        "${input:selectPort}",
        "--fqbn",
        "seeeduino:samd:seeed_wio_terminal",
        "${fileDirname}"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "Arduino: Compile (Wio Terminal)"
    },
    {
      "label": "Arduino: Upload (Arduino Nano ESP32)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "upload",
        "-p",
        "${input:selectPort}",
        "--fqbn",
        "arduino:esp32:nano_nora",
        "${fileDirname}"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "Arduino: Compile (Arduino Nano ESP32)"
    }
  ],
  "inputs": [
    {
      "id": "selectPort",
      "type": "promptString",
      "description": "接続ポート（arduino-cli board list で確認）"
    }
  ]
}
